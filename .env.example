# Copy to .env.local. Node 24+. Never put server secrets in VITE_ variables.
# Leave ALL Supabase/database fields empty for the single-user local fallback.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# PostgreSQL Session pooler URI from Supabase Connect (port 5432).
# Password can be supplied separately below; no percent-encoding needed there.
DATABASE_URL=
DATABASE_PASSWORD=
# Optional replacement CA path. Supabase's public CA is bundled in server/certs.
DATABASE_CA_FILE=
APP_ORIGIN=http://127.0.0.1:4173
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1-mini
# Shared daily cap across all accounts, including failed/unknown attempts.
PHOTO_DAILY_LIMIT=10
PHOTO_USER_DAILY_LIMIT=3
